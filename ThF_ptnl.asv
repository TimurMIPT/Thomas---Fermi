function [F,z] = ThF_ptnl(x,C)
%THF_PTNL solver for Chi function of Thomas-Fermi potential

%x = [1e-10,0.0001:0.0001:40];
%[F,z] = ThF_potential(x,-1.616624655);


t = sqrt(x);
y0 = [1,C];

[z,y] = ode45(@fun,t,y0,[x(1),x(end)]);

F = y;
z = z.^2;

end


function df = fun(t,y)
    df(1,1) =  2.*y(2).*t;
    df(2,1) =  2.*sqrt((y(1).^3));
end

